+        return LRESULT(0);
+    }
+    if let Some(result) = FALLBACK_WINDOW_INPUT
+        .get()
+        .and_then(|handle| handle(hwnd.0 as usize, message, wparam.0, lparam.0))
+    {
+        return LRESULT(result);
+    }
