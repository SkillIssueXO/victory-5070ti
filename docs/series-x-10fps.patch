+type WindowInputHandler = fn(usize, u32, usize, isize) -> Option<isize>;
+static FALLBACK_WINDOW_INPUT: OnceLock<WindowInputHandler> = OnceLock::new();
+
+/// Handles optional host input on the renderer's window when the title has
